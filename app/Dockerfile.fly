# One-process Amanah Care for a small host: api + projector + notifier inline,
# in-memory Postgres (pg-mem), web on the same port under /api. Data resets on restart.
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
COPY api/package*.json ./api/
COPY projector/package*.json ./projector/
COPY notifier/package*.json ./notifier/
RUN npm install --no-audit --no-fund \
 && cd api && npm install --omit=dev --no-audit --no-fund \
 && cd ../projector && npm install --omit=dev --no-audit --no-fund \
 && cd ../notifier && npm install --omit=dev --no-audit --no-fund
COPY . .
ENV PORT=4000 WEB_PORT=8080 NODE_ENV=production
EXPOSE 8080
CMD ["node", "dev/stack.mjs"]

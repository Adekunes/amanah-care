{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://suites-lasting-renewable-measurement.trycloudflare.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}